module object_set(                    // input to object_Laplacian 

input  wire [1:0] top_impedance,      // note that pressure should actually be -1 to 1
input  wire [1:0] bottom_impedance,   // background impedance should be 1
input  wire [1:0] left_impedance,
input  wire [1:0] right_impedance,
input wire [1:0] middle_impedance,
output reg [4:0] wall_case            // For case 0000 please do not feed into object_laplacian because thats the case for the background and its not my job
);

wire top_obj;
wire bottom_obj;
wire left_obj;
wire right_obj;
wire middle_obj;
parameter [1:0] BACKGROUND = 2'b01;

assign top_obj    = (top_impedance    != BACKGROUND);  //assume 1 object so if impedance different from background is object
assign bottom_obj = (bottom_impedance != BACKGROUND);
assign left_obj   = (left_impedance   != BACKGROUND);
assign right_obj  = (right_impedance  != BACKGROUND);
assign middle_obj = (middle_impedance != BACKGROUND);

wire [4:0] merged;
assign merged = {top_obj, left_obj, bottom_obj, right_obj, middle_obj};


always @(*) begin
  
  case(merged)
    5'b00000: wall_case = 5'd0;
    5'b00100: wall_case = 5'd1;
    5'b00010: wall_case = 5'd2;
    5'b10000: wall_case = 5'd3;
    5'b01000: wall_case = 5'd4;
    5'b11011: wall_case = 5'd5;
    5'b11101: wall_case = 5'd6;
    5'b01111: wall_case = 5'd7;
    5'b10111: wall_case = 5'd8;
    5'b11111: wall_case = 5'd9;
    5'b00111: wall_case = 5'd10;
    5'b01101: wall_case = 5'd11;
    5'b10011: wall_case = 5'd12;
    5'b11001: wall_case = 5'd13;
    5'b00001: wall_case = 5'd14;

  default: wall_case = 5'd0;
endcase
end
endmodule
